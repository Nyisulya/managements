# Security & Environment
SECRET_KEY=your_django_secret_key_here
DEBUG=False
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=https://your-domain.com,http://127.0.0.1:8000,https://harakapay.net

# Base URL of this billing system (used for webhooks and pay links)
BASE_URL=https://your-domain.com

# HarakaPay Mobile Money Gateway (M-Pesa, Tigo Pesa, Airtel Money, HaloPesa)
HARAKAPAY_API_KEY=your_harakapay_api_key_here
HARAKAPAY_BASE_URL=https://harakapay.net
PAYMENT_GATEWAY=harakapay

# Email Delivery (Resend API - Primary Engine)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_SENDER=Felician <info@your-domain.com>

# Email SMTP Delivery (Gmail Fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here
